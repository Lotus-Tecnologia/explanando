# ============================================================================================
#  Variáveis do compose de produção. Copie para deploy/.env na VPS e preencha:
#
#      cp exemplo.env .env && chmod 600 .env
#
#  O .env NÃO vai para o git (.gitignore ignora .env*). Tudo abaixo que é segredo é do
#  Gustavo — gerado por ele, nas contas dele.
# ============================================================================================

# Sobe o túnel do Cloudflare junto. Sem isso, o site fica de pé mas só dentro da máquina.
COMPOSE_PROFILES=publico

# ── Banco ────────────────────────────────────────────────────────────────────────────────
# Gere com:  openssl rand -hex 24
# Só hexadecimal, de propósito: vai dentro de uma string de conexão, e `;` ou `=` na senha
# quebram o parse dela.
POSTGRES_PASSWORD=

# Memória do Postgres. Os padrões do compose são para a máquina de 12 GB (3GB / 8GB).
# Na de 6 GB, use metade:
# PG_SHARED_BUFFERS=1536MB
# PG_EFFECTIVE_CACHE_SIZE=4GB
# PG_MAINTENANCE_WORK_MEM=256MB

# ── API e frontend ───────────────────────────────────────────────────────────────────────
# O segredo compartilhado entre o frontend e a API, que tira o nosso renderizador do teto
# público de 120/min. Gere com:  openssl rand -hex 32
CHAVE_INTERNA=

SITE_URL=https://explanando.com.br

# Trava de indexação. Vazio = não indexa, que é o padrão seguro. Só a grafia exata `true`
# liga — e só depois de olhar o site no ar (ver docs/desdobramento.md).
INDEXAVEL=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → Create tunnel (cloudflared) → o token do comando
# de instalação. Os nomes públicos se apontam lá mesmo (ver docs/desdobramento.md).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Backup no R2 ─────────────────────────────────────────────────────────────────────────
# R2 → Manage API Tokens → token com "Object Read & Write" SÓ no balde de backup.
# O endpoint é https://<ID-DA-CONTA>.r2.cloudflarestorage.com
BACKUP_ENDPOINT=
BACKUP_CHAVE_ID=
BACKUP_CHAVE_SECRETA=
BACKUP_BALDE=explanando-backup

# Opcional, e recomendado: um check no healthchecks.io (gratuito) para cada rotina. Sem
# isso, backup que para de rodar só é descoberto no dia em que se precisa dele.
BACKUP_AVISO_URL=
CONFERENCIA_AVISO_URL=
