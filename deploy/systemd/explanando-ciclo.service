[Unit]
Description=Explanando: ciclo mensal (coleta das duas casas, varredura, rede, consolidacao)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/explanando/deploy
ExecStart=/usr/bin/docker compose run --rm worker ciclo-mensal
TimeoutStartSec=infinity
