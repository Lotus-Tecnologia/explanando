{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "explanando",
  "main": ".open-next/worker.js",

  // Data a partir da qual o runtime adota o comportamento novo. Precisa ser recente para o
  // adaptador funcionar; mudar depois altera semântica de APIs em produção sem aviso.
  "compatibility_date": "2025-03-25",

  "compatibility_flags": [
    // O adaptador roda o Next no runtime Node, não no Edge — é o que permite ISR e as rotas
    // dinâmicas funcionarem como funcionam na Vercel.
    "nodejs_compat",

    // Faz `fetch` para o próprio domínio sair e voltar pela rede pública em vez de curtar
    // caminho dentro do Worker. Sem isso, a chamada do build para a API se comportaria
    // diferente da chamada em produção — e diferença silenciosa entre ambientes é a classe
    // de erro mais cara que existe neste projeto.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "explanando"
    }
  ],

  // O disco do ISR. Sem este balde, `revalidate` não tem onde guardar a página regenerada e
  // cada acesso depois da janela volta a bater na API.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "explanando-cache-incremental"
    }
  ],

  "observability": {
    "enabled": true
  }
}
