# Variaveis do frontend. Copie para .env.local e ajuste.
#
# Nenhuma delas e' segredo AQUI — este arquivo e' versionado de proposito, para que as
# variaveis fiquem explicadas em algum lugar. Os valores de verdade vao no .env.local, que
# nao e' versionado.

# Onde a API de leitura responde. Sem isto, http://localhost:5199.
# Leva NEXT_PUBLIC_ porque tambem e' usada em tempo de build para descobrir os 513 perfis.
NEXT_PUBLIC_API=http://localhost:5199

# O endereco publico do site. Entra no sitemap, no robots.txt e nos canonicos — endereco
# errado ali faz o buscador tentar indexar pagina que nao existe.
NEXT_PUBLIC_SITE_URL=https://explanando.com.br

# Como este renderizador se identifica para a API.
#
# A API publica tem teto por origem, e este processo e' o cliente mais pesado que existe por
# IP: o build busca as tres paginas de ranking e os 513 perfis de um endereco so, com onze
# processos em paralelo. SEM ISTO O BUILD QUEBRA com 429 — medido, nao suposto.
#
# **NAO** ponha NEXT_PUBLIC_ na frente. As que levam o prefixo o Next embute no pacote que
# vai para o navegador, e uma chave embutida num pacote publico deixa de ser chave. Todas as
# chamadas a API acontecem no servidor, entao o prefixo nao e' necessario.
#
# O valor tem de ser o mesmo de RateLimit:ChaveInterna na API (RateLimit__ChaveInterna como
# variavel de ambiente).
EXPLANANDO_CHAVE_INTERNA=
