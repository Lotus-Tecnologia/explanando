root = true

# ============================================================================
#  Explanando - convencoes de codigo do backend
# ============================================================================

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# --- Organizacao ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# --- Preferencias de linguagem ---
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# ============================================================================
#  Migrations
# ============================================================================
#  Codigo gerado pelo `dotnet ef migrations add`. Nao e' escrito a mao e nao deve
#  ser reescrito a mao — a proxima geracao desfaria qualquer ajuste. Marcar como
#  gerado desliga os analisadores sem afrouxar nada no codigo que nos escrevemos.

[src/**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ============================================================================
#  Projetos de teste
# ============================================================================
#  Nomes de teste em snake_case sao intencionais: o nome do metodo E' a frase
#  que descreve a regra ("Dominio_nao_referencia_nenhum_outro_projeto").
#  Legibilidade do relatorio de teste vale mais que a convencao de nomes da BCL.

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none   # sublinhados em nomes de membro
dotnet_diagnostic.CA1515.severity = none   # tipos publicos poderiam ser internos
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait em codigo de teste
dotnet_diagnostic.CA1861.severity = none   # arrays constantes como argumento
